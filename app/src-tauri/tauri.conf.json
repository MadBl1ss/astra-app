{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strelka",
  "version": "../package.json",
  "identifier": "io.github.madbl1ss.strelka",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm icons && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Стрелка",
        "width": 960,
        "height": 640,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0f1216"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Strelka",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["Russian"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2Q0RENUZBRkI4MzVBMzkKUldRNVdvUDcrdFhORmhxcmxrbDlKRnVwRFREdXNvSHBKdklTcnNUazBtTEZkUVhJNjhEN2VXVXkK",
      "endpoints": ["https://github.com/MadBl1ss/strelka-app/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
