hwid.txt
xray.json
profile.json
settings.json
server-stats.json
tray-settings.json
cache.db
*.log
journal.jsonl
config.bak.json
config.before-*.json
/core/**/run/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
